# Copy file này thành .env.local và điền URL backend thật.
# KHÔNG commit .env.local lên git.

# Local dev:
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Production (ví dụ):
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# Email nhận yêu cầu về dữ liệu cá nhân, hiển thị trên trang /privacy (TÙY CHỌN).
# Để trống thì trang chỉ ghi "liên hệ quản trị viên Legal AI".
# NEXT_PUBLIC_PRIVACY_EMAIL=privacy@yourdomain.com
