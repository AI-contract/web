# Copy file này thành .env.local và điền URL backend thật.
# KHÔNG commit .env.local lên git.

# Local dev:
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Production (ví dụ):
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# Email nhận yêu cầu về dữ liệu cá nhân, hiển thị trên trang /privacy (TÙY CHỌN).
# Để trống thì trang chỉ ghi "liên hệ quản trị viên Legal AI".
# NEXT_PUBLIC_PRIVACY_EMAIL=privacy@yourdomain.com

# Tư vấn pháp lý AI (IRAC) — trang /legal-lookup/research (TÙY CHỌN).
# Thử giao diện bằng dữ liệu minh hoạ khi backend /legal/research chưa sẵn sàng (KHÔNG bật ở production):
# NEXT_PUBLIC_LEGAL_RESEARCH_MOCK=1
# Hiện liên kết vào trang này ở trang Tra cứu pháp lý (bật khi backend /legal/research đã chạy ổn):
# NEXT_PUBLIC_LEGAL_RESEARCH_ENABLED=1

# Đích của nút "Nâng cấp gói" khi hết hạn mức Tư vấn pháp lý AI trong tháng (TÙY CHỌN).
# Đường dẫn nội bộ bắt đầu bằng "/" hoặc URL https://. Mặc định: /dashboard?tab=intro
# NEXT_PUBLIC_UPGRADE_URL=/dashboard?tab=intro
